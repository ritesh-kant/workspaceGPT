# Set these in Vercel Dashboard > Settings > Environment Variables

# Atlassian OAuth proxy (/api/token)
ATLASSIAN_CLIENT_ID=your_client_id_here
ATLASSIAN_CLIENT_SECRET=your_client_secret_here

# GitHub OAuth App — "Authorize" flow, token exchange (/api/github/oauth-token)
# Client ID + secret from the OAuth App settings page. This is the ACTIVE
# GitHub auth path.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# (OPTIONAL) GitHub App mode — installation-token minting
# (/api/github/installation-token). Only needed if you switch to the bot-identity
# / per-repo App instead of the OAuth App above.
# APP_ID is the numeric App ID; PRIVATE_KEY is the App's .pem, base64-encoded to
# survive single-line env vars:  base64 -i your-app.private-key.pem | pbcopy
# GITHUB_APP_ID=your_github_app_id
# GITHUB_APP_PRIVATE_KEY=base64_encoded_pem_or_raw_pem

# Vercel OAuth integration (/api/vercel/token)
VERCEL_CLIENT_ID=your_vercel_integration_client_id
VERCEL_CLIENT_SECRET=your_vercel_integration_client_secret

# Note: this single Vercel app hosts all OAuth/secret-keeper endpoints for the
# VS Code extension (Confluence token exchange, GitHub App installation tokens,
# Vercel OAuth). No secret ever ships in the extension bundle.
