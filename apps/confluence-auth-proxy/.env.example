# Set these in Vercel Dashboard > Settings > Environment Variables

# Atlassian OAuth proxy
ATLASSIAN_CLIENT_ID=your_client_id_here
ATLASSIAN_CLIENT_SECRET=your_client_secret_here

# Team proxy — all three are required for the Chrome extension team mode
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-master-api-key
GEMINI_API_KEY=your-gemini-api-key          # used by /api/search to embed queries server-side
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.0-flash                  # locks the model; client cannot override
# QDRANT_COLLECTION_PREFIX=                 # optional: namespace for multi-tenant setups

# Shared auth — distribute this token to team members; rotate to revoke all access
WORKSPACEGPT_ACCESS_TOKEN=generate-a-strong-random-secret
