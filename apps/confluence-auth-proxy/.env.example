# Set these in Vercel Dashboard > Settings > Environment Variables

# Atlassian OAuth proxy
ATLASSIAN_CLIENT_ID=your_client_id_here
ATLASSIAN_CLIENT_SECRET=your_client_secret_here

# Qdrant search proxy (Phase 4b — team distribution)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-master-api-key
# QDRANT_COLLECTION_PREFIX=   # optional: namespace for multi-tenant setups

# LLM chat proxy (same shared access token as Qdrant proxy)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-llm-api-key

# Shared auth — distributed to team members (rotate without touching Qdrant/LLM)
WORKSPACEGPT_ACCESS_TOKEN=generate-a-strong-random-secret
