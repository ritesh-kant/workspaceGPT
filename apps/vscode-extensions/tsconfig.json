{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "dist",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "allowUnreachableCode": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@workspace-gpt/confluence-utils": ["../../packages/confluence-utils/src"],
      "@workspace-gpt/embedding-core": ["../../packages/embedding-core/src/index.ts"],
      "@workspace-gpt/release-core": ["../../packages/release-core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", ".vscode-test", "webview"]
}