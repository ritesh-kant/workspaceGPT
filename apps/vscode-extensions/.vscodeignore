# Source and build tooling
src/**
scripts/**
esbuild.config.js
tsconfig.json
constants.ts
.eslintrc.json
.gitignore
.yarnrc
.env

# Editor / test
.vscode/**
.vscode-test/**
coverage/
.nyc_output

# Docs (keep the license)
*.md
!LICENSE.md

# Root models are copied to dist/models during build
models/**

# Webview: ship only the Vite output. Ignore node_modules explicitly,
# including the pnpm store (dot-directory `.pnpm` is skipped by some
# vsce glob implementations when only `node_modules/**` is listed).
webview/src/**
webview/node_modules/**
webview/node_modules/.pnpm/**
webview/package.json
webview/tsconfig.json
webview/vite.config.ts
webview/pnpm-lock.yaml

# Root node_modules — runtime deps are copied into dist/node_modules
node_modules/**
**/.pnpm/**

# Re-include the packaged runtime payload
!dist/node_modules/**
!dist/models/**

# Drop caches and protobufjs CLI if they still land in dist
**/.cache/**
**/protobufjs/cli/**

# Maps / types / wasm (onnxruntime-web wasm is unused; Node backend is used)
**/*.map
**/*.ts
**/*.d.ts
**/*.wasm

# Leftover artifacts in the extension folder
*.vsix
*.tgz
*.log

# Runtime junk
pids
*.pid
*.seed
*.pid.lock
.npm
.node_repl_history
.yarn-integrity
