{
  "name": "desktop",
  "version": "0.0.5",
  "private": true,
  "description": "WorkspaceGPT Desktop \u2014 Tauri shell + Node sidecar running the VS Code extension host through a vscode compat module",
  "scripts": {
    "build": "node sidecar/esbuild.config.mjs",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "usage-check": "node sidecar/usage-check.mjs",
    "dev:headless": "node scripts/dev-headless.mjs",
    "dev": "node scripts/dev-tauri.mjs",
    "seed:from-vscode": "node scripts/seed-from-vscode.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "stage": "node scripts/stage-runtime.mjs",
    "release": "node scripts/build-release.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "typescript": "5.7.3",
    "typescript-language-server": "5.3.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "22.13.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.20.1",
    "workspacegpt-extension": "workspace:*"
  }
}
