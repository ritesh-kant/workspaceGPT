{
  "name": "workspacegpt-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs && node --no-warnings test/proxy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply workspacegpt-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply workspacegpt-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.0"
  }
}
