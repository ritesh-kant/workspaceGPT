{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspacegpt-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Public GitHub OAuth App client id — reuses the same App deployment
    // automation's GitHubOAuthService uses (see GITHUB_OAUTH in
    // apps/vscode-extensions/constants.ts). Only the client SECRET is
    // sensitive; it is set separately via `wrangler secret put GITHUB_CLIENT_SECRET`
    // (or apps/workspacegpt-api/.dev.vars, gitignored, for local `wrangler dev`).
    "GITHUB_CLIENT_ID": "Ov23liuwYl36ZVETh3Nk",
    // The one model every remote-mode request is routed to. Server-side on
    // purpose — swapping models is a `wrangler deploy`, not an extension
    // release. The OpenRouter key itself is a secret:
    // `wrangler secret put OPENROUTER_API_KEY`.
    "OPENROUTER_MODEL": "google/gemini-2.5-flash",
    // Daily per-user request cap for plans not named in PLAN_DAILY_LIMITS
    // (src/usage.ts). Every request spends the vendor's OpenRouter key.
    "DAILY_REQUEST_LIMIT": "200"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ca21bd65cff24fccbd72d4b92096e596"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workspacegpt-db",
      "database_id": "ff61b37d-47e6-4c22-a507-7bd703f49cbb"
    }
  ]
}
