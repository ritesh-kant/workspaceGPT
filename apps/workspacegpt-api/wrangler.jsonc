{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspacegpt-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    // Public GitHub OAuth App client id — reuses the same App deployment
    // automation's GitHubOAuthService uses (see GITHUB_OAUTH in
    // apps/vscode-extensions/constants.ts). Only the client SECRET is
    // sensitive; it is set separately via `wrangler secret put GITHUB_CLIENT_SECRET`
    // (or apps/workspacegpt-api/.dev.vars, gitignored, for local `wrangler dev`).
    "GITHUB_CLIENT_ID": "Ov23liuwYl36ZVETh3Nk",
    // ── Deploy-time defaults ─────────────────────────────────────────────
    // Every value below is overridable at runtime by a row in the `app_config`
    // D1 table, with no redeploy — the Worker reads that table on each request
    // (batched with the user lookup, so it's free). Precedence and the exact
    // key names live in src/config.ts; the wrangler commands to set them are in
    // CLOUDFLARE-REMOTE-MODE-DESIGN.md §"Configuration".

    // Which upstream vendor remote-mode requests are routed to — "openrouter"
    // or "custom" (see ProviderName in src/config.ts). Each has its own key +
    // model below; "custom" additionally needs a base URL. Switching vendors
    // is editing these vars/secrets, no code change.
    "INFERENCE_PROVIDER": "openrouter",

    // ── openrouter — key: `wrangler secret put OPENROUTER_API_KEY` ─────────
    // Model must support tool calling — the agent loop depends on it.
    "OPENROUTER_MODEL": "z-ai/glm-5.3-flash",

    // ── custom — key: `wrangler secret put CUSTOM_API_KEY` ──────────────────
    // Any OpenAI-compatible chat-completions endpoint (TokenRouter, GMI Cloud,
    // self-hosted, ...). Both ignored unless INFERENCE_PROVIDER is "custom".
    "CUSTOM_API_BASE_URL": "https://api.tokenrouter.com/v1/chat/completions",
    "CUSTOM_MODEL": "z-ai/glm-5.3-free",
    // Usage is metered in vendor tokens and shown as credits (src/metering.ts):
    // one credit = TOKENS_PER_CREDIT tokens, charged per served request from
    // the usage the vendor reports. One allowance, keyed on `users.plan`:
    // PLAN_WEEKLY_CREDITS, per ISO week, resetting Monday 00:00 UTC. (A second,
    // rolling 5-hour allowance existed briefly and was removed 2026-09-06 — it
    // locked accounts out for hours with most of the week still unspent.)
    // Every request spends the vendor's key, so this is the spend control.
    // The sizes below are placeholders from the 2026-09-05 eval harness (a doc
    // answer ≈ 7 credits, an agent run ≈ 50) pending a pricing decision.
    "PLAN_WEEKLY_CREDITS": "{\"free\":50,\"pro\":50000}",
    // Weekly cap for a plan not named above.
    "WEEKLY_CREDIT_LIMIT": "50",
    "TOKENS_PER_CREDIT": "1000"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ca21bd65cff24fccbd72d4b92096e596"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workspacegpt-db",
      "database_id": "ff61b37d-47e6-4c22-a507-7bd703f49cbb"
    }
  ]
}
