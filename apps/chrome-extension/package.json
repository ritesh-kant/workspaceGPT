{
  "name": "workspacegpt-chrome",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "WorkspaceGPT for Chrome — ask questions about your Confluence & Azure DevOps knowledge from the browser side panel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "npm run build && node scripts/package.mjs",
    "publish:draft": "node scripts/publish.mjs",
    "publish:store": "node scripts/publish.mjs --publish"
  },
  "dependencies": {
    "@workspace-gpt/embedding-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.0"
  }
}
